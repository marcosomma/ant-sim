{
  "name": "ant-sim",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Anthill simulator inspired by D.M. Gordon's 'Ant Encounters: Interaction Networks and Colony Behavior' and Complex Adaptive Systems theory.",
  "author": {
    "name": "Marco Somma",
    "url": "https://github.com/marcosomma"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,html,md}\"",
    "sim:headless": "vite build --ssr scripts/headless.ts --outDir .headless --emptyOutDir --logLevel warn && node .headless/headless.js"
  },
  "dependencies": {
    "@babylonjs/core": "^8.6.1",
    "@babylonjs/gui": "^8.6.1",
    "@babylonjs/loaders": "^8.6.1",
    "@babylonjs/materials": "^8.6.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "packageManager": "pnpm@9.15.0"
}
